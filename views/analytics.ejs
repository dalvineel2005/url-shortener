<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Analytics - SnapURL</title>


    <link
        rel="preconnect"
        href="https://fonts.googleapis.com"
    >

    <link
        rel="preconnect"
        href="https://fonts.gstatic.com"
        crossorigin
    >

    <link
        href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap"
        rel="stylesheet"
    >


    <style>

        :root {

            --bg-color:
                #0b0f19;

            --card-bg:
                rgba(22, 28, 45, 0.6);

            --card-border:
                rgba(255, 255, 255, 0.08);

            --primary:
                #6366f1;

            --accent:
                #d946ef;

            --text-main:
                #f3f4f6;

            --text-muted:
                #9ca3af;

            --success:
                #10b981;

        }


        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }


        body {

            font-family:
                'Plus Jakarta Sans',
                sans-serif;

            background:
                var(--bg-color);

            color:
                var(--text-main);

            min-height:
                100vh;

            background-image:
                radial-gradient(
                    circle at 10% 20%,
                    rgba(99, 102, 241, 0.15),
                    transparent 40%
                ),
                radial-gradient(
                    circle at 90% 80%,
                    rgba(217, 70, 239, 0.1),
                    transparent 45%
                );

        }


        header {

            max-width:
                1200px;

            width:
                100%;

            margin:
                0 auto;

            padding:
                1.5rem 2rem;

            display:
                flex;

            justify-content:
                space-between;

            align-items:
                center;

        }


        .logo {

            font-size:
                1.5rem;

            font-weight:
                700;

            background:
                linear-gradient(
                    135deg,
                    var(--primary),
                    var(--accent)
                );

            background-clip:
                text;

            -webkit-background-clip:
                text;

            -webkit-text-fill-color:
                transparent;

        }


        .back {

            color:
                var(--text-main);

            text-decoration:
                none;

            padding:
                0.5rem 1rem;

            border:
                1px solid var(--card-border);

            border-radius:
                8px;

            background:
                rgba(255,255,255,0.05);

        }


        main {

            max-width:
                1200px;

            width:
                100%;

            margin:
                0 auto;

            padding:
                0 2rem 3rem;

        }


        .glass-card {

            background:
                var(--card-bg);

            backdrop-filter:
                blur(16px);

            border:
                1px solid var(--card-border);

            border-radius:
                16px;

            padding:
                1.5rem;

            margin-bottom:
                1.5rem;

        }


        h1 {

            font-size:
                1.5rem;

            margin-bottom:
                0.5rem;

        }


        .original-url {

            color:
                var(--text-muted);

            word-break:
                break-all;

        }


        .stats {

            display:
                grid;

            grid-template-columns:
                repeat(2, 1fr);

            gap:
                1rem;

        }


        .stat-card {

            background:
                rgba(15,23,42,0.6);

            border:
                1px solid var(--card-border);

            border-radius:
                12px;

            padding:
                1.5rem;

        }


        .stat-label {

            color:
                var(--text-muted);

            font-size:
                0.85rem;

            margin-bottom:
                0.5rem;

        }


        .stat-value {

            font-size:
                2rem;

            font-weight:
                700;

            color:
                var(--primary);

        }


        .grid {

            display:
                grid;

            grid-template-columns:
                repeat(2, 1fr);

            gap:
                1.5rem;

        }


        .section-title {

            font-size:
                1.1rem;

            font-weight:
                600;

            margin-bottom:
                1rem;

        }


        .item {

            display:
                flex;

            justify-content:
                space-between;

            padding:
                0.75rem 0;

            border-bottom:
                1px solid
                rgba(255,255,255,0.05);

        }


        .item:last-child {

            border-bottom:
                none;

        }


        .item-name {

            color:
                var(--text-muted);

        }


        .item-value {

            font-weight:
                600;

        }


        .date-row {

            display:
                flex;

            align-items:
                center;

            gap:
                1rem;

            margin-bottom:
                0.8rem;

        }


        .date {

            width:
                100px;

            font-size:
                0.8rem;

            color:
                var(--text-muted);

        }


        .bar-container {

            flex:
                1;

            height:
                10px;

            background:
                rgba(255,255,255,0.06);

            border-radius:
                999px;

            overflow:
                hidden;

        }


        .bar {

            height:
                100%;

            background:
                linear-gradient(
                    90deg,
                    var(--primary),
                    var(--accent)
                );

            border-radius:
                999px;

        }


        .count {

            width:
                40px;

            text-align:
                right;

            font-size:
                0.8rem;

            font-weight:
                600;

        }


        @media (max-width: 768px) {

            header {

                padding:
                    1rem;

            }


            main {

                padding:
                    0 1rem 2rem;

            }


            .stats,
            .grid {

                grid-template-columns:
                    1fr;

            }

        }

    </style>

</head>


<body>


    <header>

        <div class="logo">
            SnapURL
        </div>


        <a
            href="/"
            class="back"
        >
            ← Dashboard
        </a>

    </header>


    <main>


        <div class="glass-card">

            <h1>
                Link Analytics
            </h1>

            <p class="original-url">
                <%= url.redirectURL %>
            </p>

        </div>


        <div class="stats">


            <div class="stat-card">

                <div class="stat-label">
                    Total Clicks
                </div>

                <div class="stat-value">
                    <%= analytics.totalClicks %>
                </div>

            </div>


            <div class="stat-card">

                <div class="stat-label">
                    Unique Visitors
                </div>

                <div class="stat-value">
                    <%= analytics.uniqueVisitors %>
                </div>

            </div>


        </div>


        <br>


        <div class="grid">


            <!-- DEVICES -->

            <div class="glass-card">

                <div class="section-title">
                    Devices
                </div>


                <% Object.entries(
                    analytics.devices
                ).forEach(
                    ([name, count]) => {
                %>

                    <div class="item">

                        <span class="item-name">
                            <%= name %>
                        </span>

                        <span class="item-value">
                            <%= count %>
                        </span>

                    </div>

                <% }) %>

            </div>



            <!-- BROWSERS -->

            <div class="glass-card">

                <div class="section-title">
                    Browsers
                </div>


                <% Object.entries(
                    analytics.browsers
                ).forEach(
                    ([name, count]) => {
                %>

                    <div class="item">

                        <span class="item-name">
                            <%= name %>
                        </span>

                        <span class="item-value">
                            <%= count %>
                        </span>

                    </div>

                <% }) %>

            </div>



            <!-- OS -->

            <div class="glass-card">

                <div class="section-title">
                    Operating Systems
                </div>


                <% Object.entries(
                    analytics.operatingSystems
                ).forEach(
                    ([name, count]) => {
                %>

                    <div class="item">

                        <span class="item-name">
                            <%= name %>
                        </span>

                        <span class="item-value">
                            <%= count %>
                        </span>

                    </div>

                <% }) %>

            </div>



            <!-- REFERRERS -->

            <div class="glass-card">

                <div class="section-title">
                    Referrers
                </div>


                <% Object.entries(
                    analytics.referrers
                ).forEach(
                    ([name, count]) => {
                %>

                    <div class="item">

                        <span
                            class="item-name"
                            style="word-break: break-all;"
                        >
                            <%= name %>
                        </span>

                        <span class="item-value">
                            <%= count %>
                        </span>

                    </div>

                <% }) %>

            </div>


        </div>


        <!-- CLICKS BY DATE -->

        <div class="glass-card">

            <div class="section-title">
                Clicks Over Time
            </div>


            <%
                const dateEntries =
                    Object.entries(
                        analytics.clicksByDate
                    );

                const maxClicks =
                    dateEntries.length
                        ? Math.max(
                            ...dateEntries.map(
                                ([, count]) => count
                            )
                        )
                        : 1;
            %>


            <% if (
                dateEntries.length === 0
            ) { %>

                <p class="original-url">
                    No click data yet.
                </p>

            <% } %>


            <% dateEntries.forEach(
    ([date, count]) => {

    const percentage =
        Math.max(
            (count / maxClicks) * 100,
            3
        );

%>

    <div class="date-row">

        <div class="date">
            <%= date %>
        </div>


        <div class="bar-container">

            <div class="bar">
    <%= percentage %>
</div>

        </div>


        <div class="count">
            <%= count %>
        </div>

    </div>

<% }) %>

        </div>


    </main>


</body>

</html>