<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Protected Link - SnapURL
    </title>


    <style>

        * {
            box-sizing: border-box;
        }


        body {

            margin: 0;

            min-height: 100vh;

            display: flex;

            align-items: center;

            justify-content: center;

            background:
                radial-gradient(
                    circle at top left,
                    #1e1b4b,
                    #0b0f19 55%
                );

            color: #f3f4f6;

            font-family:
                Arial,
                sans-serif;
        }


        .card {

            width: 90%;

            max-width: 430px;

            background:
                rgba(
                    22,
                    28,
                    45,
                    0.85
                );

            border:
                1px solid
                rgba(
                    255,
                    255,
                    255,
                    0.08
                );

            border-radius: 18px;

            padding: 35px;

            box-shadow:
                0 20px 50px
                rgba(
                    0,
                    0,
                    0,
                    0.4
                );
        }


        .icon {

            width: 55px;

            height: 55px;

            display: flex;

            align-items: center;

            justify-content: center;

            border-radius: 14px;

            background:
                rgba(
                    99,
                    102,
                    241,
                    0.15
                );

            margin-bottom: 20px;

            font-size: 25px;
        }


        h1 {

            margin:
                0 0 10px;

            font-size: 25px;
        }


        p {

            color: #9ca3af;

            line-height: 1.6;

            margin-bottom: 25px;
        }


        .error {

            background:
                rgba(
                    239,
                    68,
                    68,
                    0.1
                );

            border:
                1px solid
                rgba(
                    239,
                    68,
                    68,
                    0.3
                );

            color: #fca5a5;

            padding: 12px;

            border-radius: 8px;

            margin-bottom: 16px;

            font-size: 14px;
        }


        input {

            width: 100%;

            padding: 14px 15px;

            background:
                rgba(
                    15,
                    23,
                    42,
                    0.8
                );

            color: white;

            border:
                1px solid
                rgba(
                    255,
                    255,
                    255,
                    0.08
                );

            border-radius: 9px;

            font-size: 15px;

            outline: none;

            margin-bottom: 15px;
        }


        input:focus {

            border-color: #6366f1;

            box-shadow:
                0 0 0 3px
                rgba(
                    99,
                    102,
                    241,
                    0.2
                );
        }


        button {

            width: 100%;

            padding: 14px;

            border: none;

            border-radius: 9px;

            background:
                linear-gradient(
                    135deg,
                    #6366f1,
                    #818cf8
                );

            color: white;

            font-weight: 600;

            font-size: 15px;

            cursor: pointer;
        }


        button:hover {

            opacity: 0.92;
        }

    </style>

</head>


<body>

    <div class="card">

        <div class="icon">
            🔒
        </div>


        <h1>
            Protected Link
        </h1>


        <p>
            This short link is password protected.
            Enter the password to continue.
        </p>


        <% if (
            typeof error !== "undefined" &&
            error
        ) { %>

            <div class="error">

                <%= error %>

            </div>

        <% } %>


        <form
            action="/url/<%= shortId %>/verify-password"
            method="POST"
        >

            <input
                type="password"
                name="password"
                placeholder="Enter password"
                required
                autofocus
            >


            <button type="submit">
                Continue
            </button>

        </form>

    </div>

</body>

</html>