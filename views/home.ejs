<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Dashboard - SnapURL</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap"
        rel="stylesheet"
    >

    <style>

        :root {
            --bg: #0b0f19;
            --card: rgba(22, 28, 45, 0.75);
            --border: rgba(255,255,255,0.08);
            --primary: #6366f1;
            --primary-hover: #4f46e5;
            --accent: #d946ef;
            --text: #f3f4f6;
            --muted: #9ca3af;
            --success: #10b981;
            --danger: #ef4444;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: var(--bg);
            color: var(--text);
            min-height: 100vh;

            background-image:
                radial-gradient(
                    circle at 10% 20%,
                    rgba(99,102,241,0.15),
                    transparent 40%
                ),
                radial-gradient(
                    circle at 90% 80%,
                    rgba(217,70,239,0.10),
                    transparent 45%
                );

            background-attachment: fixed;
        }

        header {
            max-width: 1200px;
            width: 100%;
            margin: auto;
            padding: 1.5rem 2rem;

            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-size: 1.5rem;
            font-weight: 700;

            background: linear-gradient(
                135deg,
                var(--primary),
                var(--accent)
            );

            background-clip: text;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .user-nav {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .user-nav span {
            color: var(--muted);
            font-size: 0.9rem;
        }

        .btn-logout {
            color: var(--text);
            text-decoration: none;

            padding: 0.5rem 1rem;

            border-radius: 8px;

            background: rgba(255,255,255,0.05);
            border: 1px solid var(--border);
        }

        .btn-logout:hover {
            color: #fca5a5;
            border-color: rgba(239,68,68,0.4);
        }

        main {
            max-width: 1200px;
            width: 100%;
            margin: auto;

            padding: 0 2rem 3rem;

            display: flex;
            flex-direction: column;
            gap: 2rem;
        }

        .card {
            background: var(--card);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);

            border: 1px solid var(--border);
            border-radius: 16px;

            padding: 2rem;

            box-shadow:
                0 8px 32px rgba(0,0,0,0.37);
        }

        h2 {
            margin-bottom: 1.5rem;
            font-size: 1.25rem;
        }

        .form-group {
            margin-bottom: 1rem;
        }

        input,
        select {
            width: 100%;

            padding: 1rem 1.25rem;

            border-radius: 10px;

            border: 1px solid var(--border);

            background: rgba(15,23,42,0.8);

            color: var(--text);

            font-family: inherit;
            font-size: 1rem;

            outline: none;
        }

        input:focus,
        select:focus {
            border-color: var(--primary);

            box-shadow:
                0 0 0 3px
                rgba(99,102,241,0.2);
        }

        .help {
            color: var(--muted);
            font-size: 0.8rem;
            margin-top: 0.4rem;
        }

        /* PASSWORD */

        .password-box {
            margin-top: 1rem;
            padding: 1rem;

            border-radius: 12px;

            border: 1px solid rgba(99,102,241,0.25);

            background: rgba(99,102,241,0.07);
        }

        .password-label {
            display: block;

            font-size: 0.9rem;
            font-weight: 600;

            margin-bottom: 0.7rem;
        }

        .password-input {
            width: 100%;
        }

        .password-checkbox {
            display: flex;
            align-items: center;

            gap: 0.7rem;

            cursor: pointer;

            font-weight: 600;
        }

        .password-checkbox input {
            width: 18px;
            height: 18px;

            accent-color: var(--primary);

            cursor: pointer;
        }

        .password-box {
            display: none;
        }

        /*
         IMPORTANT:

         :has() makes the password field appear
         immediately when checkbox is selected.
        */

        .password-section:has(
            #protectWithPassword:checked
        ) .password-box {
            display: block;
        }

        .btn-primary {
            width: 100%;

            padding: 1rem 2rem;

            border: none;
            border-radius: 10px;

            background:
                linear-gradient(
                    135deg,
                    var(--primary),
                    #818cf8
                );

            color: white;

            font-family: inherit;
            font-size: 1rem;
            font-weight: 600;

            cursor: pointer;

            margin-top: 0.5rem;
        }

        .btn-primary:hover {
            background:
                linear-gradient(
                    135deg,
                    var(--primary-hover),
                    var(--primary)
                );
        }

        .error {
            padding: 1rem;
            margin-bottom: 1rem;

            border-radius: 10px;

            background: rgba(239,68,68,0.1);

            border: 1px solid rgba(239,68,68,0.3);

            color: #fca5a5;
        }

        .success {
            padding: 1rem;

            margin-bottom: 1.5rem;

            border-radius: 10px;

            background: rgba(16,185,129,0.1);

            border: 1px solid rgba(16,185,129,0.3);
        }

        .success-title {
            color: var(--success);
            font-weight: 600;
            margin-bottom: 0.5rem;
        }

        .success a {
            color: white;
            word-break: break-all;
        }

        .table-wrapper {
            width: 100%;
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th {
            text-align: left;

            padding: 1rem;

            color: var(--muted);

            font-size: 0.8rem;

            border-bottom: 1px solid var(--border);
        }

        td {
            padding: 1rem;

            border-bottom:
                1px solid
                rgba(255,255,255,0.04);
        }

        .short-link {
            color: var(--primary);

            text-decoration: none;

            font-weight: 600;
        }

        .short-link:hover {
            color: var(--accent);
        }

        .original-url {
            max-width: 350px;

            overflow: hidden;

            text-overflow: ellipsis;

            white-space: nowrap;

            color: var(--muted);
        }

        .badge {
            display: inline-block;

            padding: 0.35rem 0.7rem;

            border-radius: 999px;

            font-size: 0.75rem;

            font-weight: 600;
        }

        .badge-green {
            background: rgba(16,185,129,0.12);
            color: #6ee7b7;
        }

        .badge-purple {
            background: rgba(99,102,241,0.12);
            color: #a5b4fc;
        }

        .badge-red {
            background: rgba(239,68,68,0.12);
            color: #fca5a5;
        }

        .action {
            color: var(--primary);

            text-decoration: none;

            font-weight: 600;

            margin-right: 1rem;
        }

        .action:hover {
            color: var(--accent);
        }

        @media(max-width:768px) {

            header {
                padding: 1rem;
            }

            main {
                padding: 0 1rem 2rem;
            }

            .card {
                padding: 1.25rem;
            }

            .user-nav span {
                display: none;
            }

            th,
            td {
                white-space: nowrap;
            }
        }

    </style>

</head>


<body>


<header>

    <div class="logo">
        🔗 SnapURL
    </div>

    <div class="user-nav">

        <span>
            Welcome Back
        </span>

        <a
            href="/user/logout"
            class="btn-logout"
        >
            Logout
        </a>

    </div>

</header>


<main>


    <!-- ==========================================
         CREATE URL
    =========================================== -->

    <div class="card">

        <h2>
            Shorten a long link
        </h2>


        <% if (
            typeof error !== "undefined" &&
            error
        ) { %>

            <div class="error">
                <%= error %>
            </div>

        <% } %>


        <% if (
            typeof id !== "undefined" &&
            id
        ) { %>

            <div class="success">

                <div class="success-title">
                    URL shortened successfully!
                </div>

                <a
                    href="/url/<%= id %>"
                    target="_blank"
                >
                    <%= id %>
                </a>

            </div>

        <% } %>


        <!-- ======================================
             IMPORTANT FORM
        ======================================= -->

        <form
            action="/url"
            method="POST"
            id="shortenForm"
        >


            <!-- URL -->

            <div class="form-group">

                <input
                    type="url"
                    name="url"
                    placeholder="Enter your long URL"
                    required
                >

            </div>


            <!-- CUSTOM ALIAS -->

            <div class="form-group">

                <input
                    type="text"
                    name="customAlias"
                    placeholder="Custom alias (optional)"
                    minlength="3"
                    maxlength="30"
                    pattern="[A-Za-z0-9_-]{3,30}"
                >

                <div class="help">
                    3-30 characters: letters,
                    numbers, hyphens and underscores.
                </div>

            </div>


            <!-- EXPIRATION -->

            <div class="form-group">

                <select
                    name="expiration"
                    id="expiration"
                >

                    <option value="never">
                        Never expires
                    </option>

                    <option value="1h">
                        Expires in 1 hour
                    </option>

                    <option value="1d">
                        Expires in 1 day
                    </option>

                    <option value="7d">
                        Expires in 7 days
                    </option>

                    <option value="30d">
                        Expires in 30 days
                    </option>

                    <option value="custom">
                        Custom date & time
                    </option>

                </select>

            </div>


            <!-- CUSTOM DATE -->

            <div
                class="form-group"
                id="customDateContainer"
                style="display:none;"
            >

                <label class="help">
                    Expiration date and time
                </label>

                <input
                    type="datetime-local"
                    name="customExpiresAt"
                    id="customExpiresAt"
                >

            </div>


            <!-- ======================================
                 PASSWORD SECTION
            ======================================= -->

            <div class="form-group password-section">


                <label
                    class="password-checkbox"
                    for="protectWithPassword"
                >

                    <input
                        type="checkbox"
                        id="protectWithPassword"
                        name="protectWithPassword"
                        value="true"
                    >

                    <span>
                        🔒 Password protect this link
                    </span>

                </label>


                <!--

                    THIS INPUT IS INSIDE THE SAME FORM.

                    It has the exact name:

                    linkPassword

                    Therefore req.body.linkPassword
                    will contain the entered password.

                -->

                <div class="password-box">

                    <label
                        class="password-label"
                        for="linkPassword"
                    >
                        Enter password
                    </label>

                    <input
                        class="password-input"
                        type="password"
                        id="linkPassword"
                        name="linkPassword"
                        placeholder="Enter password"
                        minlength="6"
                        autocomplete="new-password"
                    >

                    <div class="help">
                        Minimum 6 characters.
                    </div>

                </div>


            </div>


            <!-- SUBMIT -->

            <button
                type="submit"
                class="btn-primary"
            >
                Shorten URL
            </button>


        </form>

    </div>


    <!-- ==========================================
         URL LIST
    =========================================== -->

    <div class="card">

        <h2>
            Your shortened links
        </h2>


        <% if (
            urls &&
            urls.length > 0
        ) { %>


            <div class="table-wrapper">

                <table>

                    <thead>

                        <tr>

                            <th>
                                S.No
                            </th>

                            <th>
                                Short URL
                            </th>

                            <th>
                                Original URL
                            </th>

                            <th>
                                Expiration
                            </th>

                            <th>
                                Protection
                            </th>

                            <th>
                                Clicks
                            </th>

                            <th>
                                Analytics
                            </th>

                            <th>
                                QR Code
                            </th>

                        </tr>

                    </thead>


                    <tbody>


                    <% urls.forEach(
                        (url,index) => {

                        const expired =
                            url.expiresAt &&
                            new Date(
                                url.expiresAt
                            ).getTime() <= Date.now();

                    %>


                        <tr>

                            <td>
                                <%= index + 1 %>
                            </td>


                            <td>

                                <a
                                    class="short-link"
                                    href="/url/<%= url.shortId %>"
                                    target="_blank"
                                >
                                    <%= url.shortId %>
                                </a>

                            </td>


                            <td>

                                <div
                                    class="original-url"
                                    title="<%= url.redirectURL %>"
                                >
                                    <%= url.redirectURL %>
                                </div>

                            </td>


                            <td>

                                <% if (
                                    !url.expiresAt
                                ) { %>

                                    <span
                                        class="badge badge-green"
                                    >
                                        Never
                                    </span>

                                <% } else if (
                                    expired
                                ) { %>

                                    <span
                                        class="badge badge-red"
                                    >
                                        Expired
                                    </span>

                                <% } else { %>

                                    <span
                                        class="badge badge-purple"
                                    >
                                        <%= new Date(
                                            url.expiresAt
                                        ).toLocaleString() %>
                                    </span>

                                <% } %>

                            </td>


                            <td>

                                <% if (
                                    url.isPasswordProtected === true ||
                                    url.isPasswordProtected === "true"
                                ) { %>

                                    <span
                                        class="badge badge-purple"
                                    >
                                        🔒 Protected
                                    </span>

                                <% } else { %>

                                    <span
                                        class="badge badge-green"
                                    >
                                        Public
                                    </span>

                                <% } %>

                            </td>


                            <td>

                                <span
                                    class="badge badge-purple"
                                >
                                    <%= Array.isArray(
                                        url.visitHistory
                                    )
                                        ? url.visitHistory.length
                                        : 0
                                    %>
                                </span>

                            </td>


                            <td>

                                <a
                                    class="action"
                                    href="/url/analytics/<%= url.shortId %>"
                                    target="_blank"
                                >
                                    View
                                </a>

                            </td>


                            <td>

                                <a
                                    class="action"
                                    href="/url/qr/<%= url.shortId %>"
                                    target="_blank"
                                >
                                    QR
                                </a>

                            </td>

                        </tr>


                    <% }) %>


                    </tbody>

                </table>

            </div>


        <% } else { %>


            <div
                style="
                    text-align:center;
                    color:#9ca3af;
                    padding:3rem;
                "
            >

                No links shortened yet.

            </div>


        <% } %>


    </div>


</main>


<script>

    /*
     * CUSTOM EXPIRATION
     */

    const expiration =
        document.getElementById(
            "expiration"
        );

    const customDateContainer =
        document.getElementById(
            "customDateContainer"
        );

    const customExpiresAt =
        document.getElementById(
            "customExpiresAt"
        );


    expiration.addEventListener(
        "change",
        function () {

            if (
                this.value === "custom"
            ) {

                customDateContainer.style.display =
                    "block";

                customExpiresAt.required =
                    true;

            } else {

                customDateContainer.style.display =
                    "none";

                customExpiresAt.required =
                    false;

                customExpiresAt.value =
                    "";

            }

        }
    );


    /*
     * PASSWORD VALIDATION
     *
     * This does NOT control whether the
     * password input exists.
     *
     * The input is always physically inside
     * the form.
     */

    const form =
        document.getElementById(
            "shortenForm"
        );

    const passwordCheckbox =
        document.getElementById(
            "protectWithPassword"
        );

    const passwordInput =
        document.getElementById(
            "linkPassword"
        );


    form.addEventListener(
        "submit",
        function (event) {

            console.log(
                "========== FORM SUBMIT =========="
            );

            console.log(
                "Password checkbox:",
                passwordCheckbox.checked
            );

            console.log(
                "Password value:",
                passwordInput.value
            );


            if (
                passwordCheckbox.checked
            ) {

                if (
                    !passwordInput.value ||
                    passwordInput.value.trim() === ""
                ) {

                    event.preventDefault();

                    alert(
                        "Please enter a password for this link."
                    );

                    passwordInput.focus();

                    return;
                }


                if (
                    passwordInput.value.length < 6
                ) {

                    event.preventDefault();

                    alert(
                        "Password must be at least 6 characters."
                    );

                    passwordInput.focus();

                    return;
                }

            }

        }
    );

</script>


</body>

</html>